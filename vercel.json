{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pretty-massacure",
      "destination": "/pretty-massacre",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:slug",
      "destination": "/creator?slug=:slug"
    }
  ],
  "functions": {
    "api/twitch/eventsub.js": {
      "maxDuration": 60
    },
    "api/bot/rewards.js": {
      "maxDuration": 60
    }
  }
}
